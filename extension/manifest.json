{
  "manifest_version": 3,
  "name": "CampusGuard",
  "short_name": "CampusGuard",
  "version": "2.1.0",
  "description": "Spot phishing in Gmail and Outlook. Explains every red flag. Runs on your device; nothing is stored or sent.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "CampusGuard: check a message", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://outlook.office.com/*", "https://outlook.office365.com/*", "https://outlook.live.com/*"],
      "js": ["js/mail-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["report.html"], "matches": ["<all_urls>"] }]
}
