{
  "manifest_version": 3,
  "name": "CampusGuard",
  "short_name": "CampusGuard",
  "version": "3.2.1",
  "description": "Checks the emails you open for phishing and scams, and explains every red flag. Asks before reading any site. Runs on your device; nothing is stored or sent.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "CampusGuard", "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "declarativeContent", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
